{
  "name": "novolba-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/ensure-next-export-payloads.mjs",
    "mirror:microcms-assets": "node scripts/mirror-microcms-assets.mjs",
    "mirror:microcms-assets:scan": "node scripts/mirror-microcms-assets.mjs --scan-only",
    "start": "next start",
    "lint": "eslint",
    "preview:serve": "node preview/server.mjs",
    "build:preview:lambda": "node preview/build-lambda.mjs",
    "package:preview:lambda": "node preview/package-lambda.mjs",
    "test:preview:lambda": "node --test preview/lambda/*.test.mjs",
    "test:preview": "node --test preview/*.test.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "microcms-js-sdk": "^3.4.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
