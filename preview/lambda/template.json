{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Dedicated draftKey preview infrastructure; real Lambda ZIP is managed by the approved SDK deployment",
  "Parameters": {
    "FunctionName": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9_-]{0,63}"
    },
    "EnablePublicAccess": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "FunctionPrepared": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    }
  },
  "Conditions": {
    "FunctionExists": {
      "Fn::Equals": [
        {
          "Ref": "FunctionPrepared"
        },
        "true"
      ]
    },
    "PublicAccessEnabled": {
      "Fn::And": [
        {
          "Condition": "FunctionExists"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "EnablePublicAccess"
            },
            "true"
          ]
        }
      ]
    }
  },
  "Resources": {
    "PreviewLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${FunctionName}"
        },
        "RetentionInDays": 14
      }
    },
    "PreviewRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${FunctionName}-execution"
        },
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/microcms-preview-logs-boundary"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WritePreviewLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${FunctionName}:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "PreviewUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "AuthType": "NONE",
        "InvokeMode": "BUFFERED",
        "TargetFunctionArn": {
          "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${FunctionName}"
        }
      },
      "Condition": "FunctionExists"
    },
    "AllowFunctionUrl": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "PublicAccessEnabled",
      "DependsOn": "PreviewUrl",
      "Properties": {
        "FunctionName": {
          "Ref": "FunctionName"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "AllowInvokeViaFunctionUrl": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "PublicAccessEnabled",
      "DependsOn": "PreviewUrl",
      "Properties": {
        "FunctionName": {
          "Ref": "FunctionName"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "FunctionName": {
      "Value": {
        "Ref": "FunctionName"
      }
    },
    "FunctionUrl": {
      "Value": {
        "Fn::GetAtt": [
          "PreviewUrl",
          "FunctionUrl"
        ]
      },
      "Condition": "FunctionExists"
    },
    "RoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "PreviewRole",
          "Arn"
        ]
      }
    }
  }
}
