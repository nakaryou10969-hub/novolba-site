{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Dedicated microCMS article preview using draftKey links without additional login",
  "Parameters": {
    "FunctionName": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9_-]{0,63}"
    },
    "ServiceDomain": {
      "Type": "String",
      "Default": "unconfigured",
      "AllowedPattern": "[a-z0-9][a-z0-9-]{0,62}"
    },
    "MicrocmsApiKey": {
      "Type": "String",
      "NoEcho": true,
      "Default": "",
      "MaxLength": 1024
    },
    "PublicOrigin": {
      "Type": "String",
      "Default": "https://unconfigured.invalid",
      "AllowedPattern": "https://[a-z0-9.-]+"
    },
    "EnablePublicAccess": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    }
  },
  "Conditions": {
    "PublicAccessEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnablePublicAccess"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "PreviewLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${FunctionName}"
        },
        "RetentionInDays": 14
      }
    },
    "PreviewRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": { "Fn::Sub": "${FunctionName}-execution" },
        "PermissionsBoundary": { "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/microcms-preview-logs-boundary" },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WritePreviewLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${FunctionName}:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "PreviewFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "PreviewLogGroup",
      "Properties": {
        "FunctionName": {
          "Ref": "FunctionName"
        },
        "Description": "Article preview requiring a matching microCMS draftKey",
        "Runtime": "nodejs22.x",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "run.sh",
        "Role": {
          "Fn::GetAtt": [
            "PreviewRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 30,
        "Layers": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:753240598075:layer:LambdaAdapterLayerX86:30"
          }
        ],
        "Code": {
          "ZipFile": "exports.handler = async () => { throw new Error('Preview package has not been deployed.'); };"
        },
        "Environment": {
          "Variables": {
            "AWS_LAMBDA_EXEC_WRAPPER": "/opt/bootstrap",
            "AWS_LWA_PORT": "3001",
            "AWS_LWA_READINESS_CHECK_PROTOCOL": "tcp",
            "AWS_LWA_READINESS_CHECK_TIMEOUT_SECONDS": "5",
            "AWS_LWA_INVOKE_MODE": "buffered",
            "RUST_LOG": "warn",
            "PREVIEW_HOST": "127.0.0.1",
            "PREVIEW_PORT": "3001",
            "MICROCMS_SERVICE_DOMAIN": {
              "Ref": "ServiceDomain"
            },
            "MICROCMS_API_KEY": {
              "Ref": "MicrocmsApiKey"
            },
            "PREVIEW_PUBLIC_ORIGIN": {
              "Ref": "PublicOrigin"
            }
          }
        },
        "LoggingConfig": {
          "LogFormat": "JSON",
          "ApplicationLogLevel": "WARN",
          "SystemLogLevel": "WARN"
        }
      }
    },
    "PreviewUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "AuthType": "NONE",
        "InvokeMode": "BUFFERED",
        "TargetFunctionArn": {
          "Ref": "PreviewFunction"
        }
      }
    },
    "AllowFunctionUrl": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "PublicAccessEnabled",
      "DependsOn": "PreviewUrl",
      "Properties": {
        "FunctionName": {
          "Ref": "PreviewFunction"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "AllowInvokeViaFunctionUrl": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "PublicAccessEnabled",
      "DependsOn": "PreviewUrl",
      "Properties": {
        "FunctionName": {
          "Ref": "PreviewFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "FunctionName": {
      "Value": {
        "Ref": "PreviewFunction"
      }
    },
    "FunctionUrl": {
      "Value": {
        "Fn::GetAtt": [
          "PreviewUrl",
          "FunctionUrl"
        ]
      }
    }
  }
}
